# API base URL used by src/services/api.js
#
# Local development: the Express API runs on port 8000
VITE_API_URL=http://localhost:8000/api
#
# Production (Vercel): set VITE_API_URL=/api in the project's environment variables.
# Requests to /api/* are proxied to the Render backend by the rewrites in vercel.json,
# which keeps the auth cookie first-party (no CORS and no third-party cookie issues).
