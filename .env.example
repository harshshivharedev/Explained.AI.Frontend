# API base URL used by src/services/api.js
#
# Optional: defaults to '/api' (same-origin) when unset.
# - Local dev: the Vite dev server proxies /api/* to http://localhost:8000
#   (see server.proxy in vite.config.js)
# - Production (Vercel): /api/* is proxied to the Render backend by the
#   rewrites in vercel.json, which keeps the auth cookie first-party
#   (no CORS and no third-party cookie issues).
#
# Do NOT set this in Vercel project settings — leave it unset there so the
# /api proxy is used. Localhost values are ignored in production builds.
#
# Only set this if the API lives somewhere else:
# VITE_API_URL=http://localhost:8000/api
